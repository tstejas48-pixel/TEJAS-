# =============================================================================
# TEJAS LADIES TYLOR — Environment Configuration (.env.example)
# =============================================================================
# Duplicate this file to .env or configure these keys in AI Studio Settings.
# Never commit confidential credentials or secrets to public version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / MySQL / Supabase / Neon / Cloud SQL)
# -----------------------------------------------------------------------------
# Main database connection string (recommended):
# Examples:
#   PostgreSQL: postgresql://username:password@hostname:5432/database_name?sslmode=require
#   MySQL:      mysql://username:password@hostname:3306/database_name
#   Supabase:   postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Or discrete SQL connection parameters if using individual host credentials:
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=tejas_ladies_tailor
DB_SSL=true

# -----------------------------------------------------------------------------
# 2. SUPABASE (If using Supabase as your database & auth backend)
# -----------------------------------------------------------------------------
# Project URL & API Keys from Supabase Dashboard > Project Settings > API:
SUPABASE_URL=https://hzghrpyulzqqirkygkbd.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client-side Supabase keys (if accessed directly from Vite frontend):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# 3. FIREBASE / FIRESTORE (If using Firebase as your database backend)
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Client-side Firebase Web SDK keys:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# 4. MONGODB (If using MongoDB Atlas or self-hosted MongoDB)
# -----------------------------------------------------------------------------
# Example: mongodb+srv://username:password@cluster.mongodb.net/tejas_db?retryWrites=true&w=majority
MONGODB_URI=

# -----------------------------------------------------------------------------
# 5. APPLICATION & AI STUDIO ENVIRONMENT
# -----------------------------------------------------------------------------
# GEMINI_API_KEY: Injected by AI Studio at runtime from user secrets
GEMINI_API_KEY=

# APP_URL: Cloud Run / preview URL for callbacks and endpoints
APP_URL=

